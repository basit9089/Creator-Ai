# ==========================================================
# Creator AI — Environment Configuration Example
# ==========================================================
# Copy this file to `.env` and adjust as needed:
#   cp .env.example .env     (macOS / Linux)
#   copy .env.example .env   (Windows)
#
# The real `.env` file is git-ignored and MUST NOT be committed.
#
# IMPORTANT: This file contains NO real secrets. Never place real
# API keys, passwords or tokens here — this file is committed.
# Secrets belong only in your local, git-ignored `.env`.
# ==========================================================

# ---------- Application ----------
APP_NAME="Creator AI API"
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
# Auto-reload is convenient in development only.
APP_RELOAD=true

# ---------- Logging ----------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# Set to true for one JSON object per log line (useful for log collectors).
LOG_JSON=false

# ---------- Ollama / AI Provider ----------
# Host of the Ollama server. Not exposed to the frontend.
OLLAMA_HOST=http://127.0.0.1:11434
# Default model used when a request does not specify one.
OLLAMA_MODEL=qwen3:8b
# Seconds to wait for a non-streaming generation before giving up.
# Long generations on CPU can take a while, so this is generous.
OLLAMA_TIMEOUT=300

# ---------- CORS / Frontend ----------
# Comma-separated list of allowed browser origins.
FRONTEND_URL=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated list of allowed methods.
CORS_ALLOW_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
# Comma-separated list of allowed headers. Use "*" for all.
CORS_ALLOW_HEADERS=*

# ---------- API Limits ----------
# Maximum accepted prompt size, in characters. Prevents unbounded
# input reaching the model.
MAX_PROMPT_LENGTH=8000

# ---------- Default AI generation settings ----------
# Applied to any generation that does not specify its own options.
# Individual agent calls may override these at any time.
DEFAULT_AI_TEMPERATURE=0.7
DEFAULT_AI_TOP_P=0.9

# Reasoning mode for hybrid models such as Qwen3.
#
# Measured on an i5-10210U / 16 GB / integrated graphics machine:
#   thinking ON  ~ 86 seconds
#   thinking OFF ~  3.6 seconds
# for the same trivial prompt. Reasoning is therefore OFF by default
# and should be enabled deliberately, per call, where it earns its cost.
DEFAULT_AI_THINKING=false
MAX_AI_OUTPUT_TOKENS=2048

# Upper bound in seconds for a single agent or API generation.
# Agents issue several calls in sequence, so this exceeds OLLAMA_TIMEOUT.
AI_REQUEST_TIMEOUT=600