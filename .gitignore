# ==========================================================
# Creator AI — Git Ignore Rules
# ==========================================================
# Purpose: stop virtual environments, dependency trees, build
# output, secrets and logs from being tracked by Git.
# NOTE: these rules only affect Git tracking. Existing folders
# (.venv/, node_modules/) are intentionally left on disk.
# ==========================================================

# ---------- Secrets / environment ----------
.env
.env.*
!.env.example

# ---------- Python ----------
backend/.venv/
venv/
.venv/
ENV/
env/
__pycache__/
backend/__pycache__/
backend/**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
*.egg-info/
build/
dist/

# ---------- Node / Frontend ----------
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Logs ----------
logs/
*.log

# ---------- Local media storage (never committed) ----------
# Generated by the Video Producer. Anchored to the repository root so
# source directories that happen to be called "media" are unaffected.
/renders/
/media/
/projects/
/backend/renders/
*.mp4
*.mov
*.mkv
*.m4a
*.srt

# ---------- OS ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editors / IDEs ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- Local tooling scratch ----------
tmp/
temp/
*.bak
*.orig